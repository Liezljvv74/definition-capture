# Copy to .env.local and fill in from your Supabase project:
# Dashboard → Project Settings → API. Both values are compiled into the
# browser bundle, so neither is a secret — the publishable key is meant to be
# public, and row level security is what protects the data behind it.
#
# Wherever the app is eventually hosted will need the same two values in its
# build environment. Without them the app still builds and runs, but every
# visitor gets the "no Supabase credentials" message instead of a sign-in form.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Cloudflare Turnstile site key. Public by design, like the publishable key: it
# is compiled into the browser bundle. Needed in .env.local too once captcha is
# on in Supabase, because local development uses the live project (localhost is
# a listed hostname on the widget). Leave it empty only against a local Supabase
# copy, where captcha is off. The secret key goes only into the Supabase
# dashboard (Authentication, Attack Protection), never into code, .env.local,
# or Vercel.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
